# Porta do servidor da API de fotos
PORT=3000

# Chave privada exigida no header `x-api-key`.
# Troque por um valor forte e mantenha em segredo (não versionar o .env real).
PHOTO_API_KEY=copa26-dev-key

# Token do football-data.org — usado APENAS pelo script de coleta (npm run collect).
FOOTBALL_API_TOKEN=

# Código da competição a coletar (padrão: Copa do Mundo)
COMPETITION_CODE=WC

# (Opcional) Chave da API-Football (api-sports.io) para headshots oficiais
# padronizados. Sem ela, a coleta usa TheSportsDB + Wikipedia.
APIFOOTBALL_KEY=

# (Opcional) Chave do TheSportsDB. Padrão '3' é a chave de teste pública.
SPORTSDB_API_KEY=3
